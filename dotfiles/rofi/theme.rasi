/**
 * Monochrome terminal rofi theme
 * Matches the xmobar setup: #181818 background, #b9b9b9 foreground/border
 */

* {
    background:         #181818;
    background-alt:     #181818;
    foreground:         #b9b9b9;
    border-color:       #b9b9b9;
    selected:           #181818;
    selected-bg:        #b9b9b9;
    active:             #b9b9b9;
    urgent:             #b9b9b9;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color:  @background;
    border:            1px;
    border-color:      @border-color;
    border-radius:      0px;
    padding:            20px;
    width:              600px;
    location:           center;
    anchor:             center;
}

mainbox {
    background-color:  @background;
    children:           [ inputbar, message, listview ];
    spacing:            14px;
}

inputbar {
    background-color:  @background;
    text-color:         @foreground;
    border:             0px 0px 1px 0px;
    border-color:       @border-color;
    padding:            0px 0px 10px 0px;
    children:           [ prompt, entry ];
    spacing:            10px;
}

prompt {
    background-color:  @background;
    text-color:         @foreground;
}

entry {
    background-color:  @background;
    text-color:         @foreground;
    placeholder:        "search...";
    placeholder-color:  @foreground;
    cursor:             text;
}

message {
    background-color:  @background;
    border:             0px;
}

textbox {
    background-color:  @background;
    text-color:         @foreground;
}

listview {
    background-color:  @background;
    columns:            1;
    lines:              8;
    spacing:            4px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    fixed-height:       false;
}

element {
    background-color:  @background;
    text-color:         @foreground;
    orientation:        horizontal;
    padding:            6px 10px;
    border:             0px;
}

element normal.normal {
    background-color:  @background;
    text-color:         @foreground;
}

element selected.normal {
    background-color:  @selected-bg;
    text-color:         @selected;
}

element alternate.normal {
    background-color:  @background;
    text-color:         @foreground;
}

element-icon {
    background-color:  transparent;
    size:               22px;
    horizontal-align:   0.5;
    vertical-align:     0.5;
}

element-text {
    background-color:  transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

scrollbar {
    handle-color:       @foreground;
    handle-width:       2px;
    border-radius:      0px;
}
