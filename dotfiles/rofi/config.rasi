@theme "~/.config/rofi/theme.rasi"

configuration {
	modi: "drun,run,ssh";
	show-icons: true;
	hide-scrollbar: true;
	terminal: "alacritty";
	ssh-command: "{terminal} --hold sh -c 'source ~/.profile; ssh -Y {host}'";
	run-command: "{cmd}";
	run-shell-command: "{terminal} --hold {cmd}";
	sort: true;
	scroll-method: 1;
	sidebar-mode: false;

	window-format: "{c}		{t}";

	display-drun: ">";
	display-run: ">";
	display-ssh: "";

	parse-known-hosts: false;
}
