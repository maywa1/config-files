{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["clock"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○"
    }
  },
  "clock": {
    "format": "{:%H:%M  |  %a %d %b}",
    "tooltip-format": "{:%A, %B %d}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-icons": ["", "", ""]
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ipaddr}",
    "format-disconnected": "  Disconnected"
  },
  "cpu": {
    "format": "  {usage}%"
  },
  "memory": {
    "format": "  {}%"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "format-charging": "  {capacity}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 5
  }
}
