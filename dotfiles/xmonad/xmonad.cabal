cabal-version: 3.0
name: xmonad-config
version: 0.1.0.0

executable xmonad-config
  main-is:          xmonad.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  hs-source-dirs:   ., lib
  other-modules:    ClipboardManager
  build-depends:    base
                   , xmonad
                   , xmonad-contrib
                   , process
                   , directory
                   , filepath
  default-language: Haskell2010

executable clipboard-daemon
  main-is:          ClipboardDaemon.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  hs-source-dirs:   app, lib
  other-modules:    ClipboardManager
  build-depends:    base
                   , process
                   , directory
                   , filepath
  default-language: Haskell2010
