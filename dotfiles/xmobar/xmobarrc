Config { font    = "xft:JetBrainsMono Nerd Font:size=12:bold"
       , additionalFonts = []
       , bgColor = "#181818"
       , fgColor = "#b9b9b9"
       , position = BottomSize C 99 50
       , textOffset = -1
       , border = FullB
       , borderColor = "#b9b9b9"
       , borderWidth = 1
       , alpha = 255
       , commands = [ Run Cpu ["-L","3","-H","50"] 20
                    , Run Memory ["-t","Mem: <usedratio>%"] 20
                    , Run Date "%d %B %Y - %A | %H:%M" "date" 10
                    , Run Battery [ "-t", "bat. <left>%" ] 50
                    , Run Volume "default" "Master" ["-t", "spk.<volume>%"] 10
                    , Run StdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "   %StdinReader%   }{   %cpu% | %memory% | %default:Master% | %battery% | %date%   "
       }
